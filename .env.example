# Reference only: the app does not load .env automatically. Never commit your filled copy.
VOICE_LIVE_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.services.ai.azure.com
GPT_LIVE_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.openai.azure.com
GPT_LIVE_DEPLOYMENT=gpt-live-1
AZURE_AUTH_MODE=managed_identity
# Required for a user-assigned managed identity; omit for system-assigned identity.
AZURE_CLIENT_ID=YOUR-MANAGED-IDENTITY-CLIENT-ID
PORTAL_USERNAME=developer
PORTAL_PASSWORD_HASH=GENERATE-WITH-tools-make_credentials.py
PORTAL_SESSION_SECRET=GENERATE-A-NEW-RANDOM-SECRET
APP_VERSION=recognition-uat-20261104-r2
ALLOW_INSECURE_LOCALHOST=false
